Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Code and data folders are never served directly.
  RewriteRule ^(inc|data|private)(/|$) - [F,L]

  # Staging or any other host than lasemcakes.ca: keep search engines out.
  RewriteCond %{HTTP_HOST} !(^|\.)lasemcakes\.ca$ [NC]
  RewriteRule ^robots\.txt$ robots-staging.txt [L]

  # One address per page: always https and a trailing slash.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteRule ^(.*)$ %{REQUEST_URI}/ [R=301,L]

  # The admin panel and the kitchen display: their code folders are never served.
  RewriteRule ^(admin|kds)/inc(/|$) - [F,L]
  RewriteRule ^(admin|kds)/(index\.php|api\.php)?$ - [L]

  # Table ordering: the table page, order tracking, the "Now serving" board, tracking QR codes.
  RewriteRule ^dine-in/(index\.php)?$ - [L]
  RewriteRule ^dine-in/(track|board|qr)/$ dine-in/index.php [L,QSA]

  # Everything that isn't a real file goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  # Staging: tell search engines not to index pages served from any host but lasemcakes.ca.
  SetEnvIfNoCase Host "(^|\.)lasemcakes\.ca$" LIVE_HOST
  Header set X-Robots-Tag "noindex, nofollow" env=!LIVE_HOST
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  # Pages are built fresh, so browsers always check for a newer copy.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # CSS and JS carry ?v=… (ASSET_VERSION) and images never change once uploaded, so browsers
  # can keep them without asking again.
  <FilesMatch "\.(css|js|webp|avif|png|jpe?g|gif|svg|ico|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compress text files: Brotli where the host has it, gzip otherwise.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml font/ttf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml font/ttf
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>
